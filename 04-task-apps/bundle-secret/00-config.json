{
  "vers": 1,
  "pick": {
    "dirs": [".secrets"],
    "files": ["*token.json", "*client_secret.json", "*credentials.json"],
    "skip_dirs": [".git", "zig-out", ".zig-cache", "node_modules", "zzzz-dele-90da", "zzzz-delete-force-items"],
    "skip_markers": ["Local State", "Preferences"],
    "skip": ["*session*"],
    "seed_only": ["*token.json"],
    "file_maxz_kbyt": 256,
    "total_maxz_mbyt": 64
  },
  "bundle": {
    "root": "{home}/04-clou-vaul",
    "path": "bundle-secret.enc",
    "need_git": true,
    "pass_file": "{home}/.04-clou-secr/04-clou-vaul.pass",
    "pass_envz": "BUNDLE_SECRET_PASS",
    "pass_min": 16
  },
  "git": { "bin": "git", "timeout_secs": 120 },
  "fetch": { "on_differ": "keep" },
  "ship": { "message": "update bundle" },
  "state": { "file": "{home}/.04-clou-secr/bundle-secret-state.json" },
  "sync": { "retired": ["30-partner-folder/*", "12-pner-apps/*"], "merge_globs": [], "tie_secs": 120, "trash_dir": "zzzz-dele-90da", "big_files": 50, "base_dir": "{home}/.04-clou-secr/bundle-secret-base" },
  "argon": { "time": 3, "memo_kbyt": 65536, "para": 1 },
  "unpack": {
    "file_mode": "600",
    "trash": "{home}/.04-clou-secr/bundle-trash"
  }
}

{
  "data_dir": "~/.pinterest-shorts",
  "db_file": "ledger.db",
  "secrets_dir": "~/.04-clou-secr",
  "tz_offset_hours": 7,
  "source": { "dir": "", "max_age_days": 14 },
  "limits": { "daily_cap": 3, "gap_min_s": 600, "gap_max_s": 1800, "disk_min_mb": 500, "run_budget_s": 1800, "usage_stop_pct": 80, "quota_block_h": 24, "req_budget_day": 800, "resolve_max_pages": 5 },
  "video": { "min_s": 4, "max_s": 90, "min_w": 540, "min_h": 960, "rec_w": 1080, "rec_h": 1920, "fps_min": 24, "fps_max": 60, "max_mb": 100, "vcodec": "avc1", "acodec": "mp4a", "audio_channels": 2, "audio_rate": 48000, "probe_tool": "" },
  "post": { "public": false, "ai_notice_required": true, "ai_values": ["AI_MODIFIED"], "title_max": 100, "desc_max": 800, "alt_max": 500, "link_max": 2048, "tags_max": 10, "cover_mode": "key_frame", "cover_key_frame_s": 1, "url_template": "https://www.pinterest.com/pin/{id}/" },
  "net": { "timeout_s": 60, "upload_timeout_s": 1800, "chunk_kb": 256, "backoff_ms": 2000, "status_poll_s": 5, "status_poll_max_s": 300, "resume_max": 3, "body_cap_kb": 512, "user_agent": "pinterest-shorts/0.1", "allow_hosts": ["api.pinterest.com", "pinterest-media-upload.s3-accelerate.amazonaws.com"] },
  "breaker": { "fails": 3, "cool_h": 6 },
  "account": { "board_secret_env": "PINT_SHOR_BOARD_SECRET", "board_secret_file": "pint-shor-board-secret", "board_public_env": "PINT_SHOR_BOARD_PUBLIC", "board_public_file": "pint-shor-board-public", "section_env": "PINT_SHOR_SECTION", "section_file": "" },
  "approval": { "require_for_review": true },
  "api": { "base": "https://api.pinterest.com", "version": "v5", "app_id_env": "PINT_APP_ID", "app_id_file": "pint-app-id", "app_secret_env": "PINT_APP_SECRET", "app_secret_file": "pint-app-secret", "access_token_env": "PINT_SHOR_ACCESS_TOKEN", "token_file": "pint-shor-token.json", "redirect_uri": "http://localhost:8085/", "authorize_url": "https://www.pinterest.com/oauth/", "scopes": ["pins:read", "pins:write", "boards:read", "user_accounts:read", "boards:read_secret", "pins:read_secret", "pins:write_secret"] },
  "retry_pre_send": 2,
  "token_refresh_days": 7,
  "token_warn_days": 14

{
  "vers": 1,
  "src": ".deve-user",
  "claude_envz": "CLAUDE_CONFIG_DIR",
  "file_maxz_kbyt": 512,
  "backup_dir": "{home}/.04-clou-secr/deve-backup",
  "roots": {
    "claude": { "linux": "{home}/.claude", "macos": "{home}/.claude", "windows": "{home}/.claude" },
    "vscode": { "linux": "{home}/.config/Code/User", "macos": "{home}/Library/Application Support/Code/User", "windows": "{appdata}/Code/User" }
  },
  "scan": {
    "names": ["*.pass", "*.pem", "*.key", "*.enc", "*credentials*", "*token*", "*secret*", "*.env", ".env*", "*id_rsa*", "*id_ed25519*"],
    "text": ["sk-ant-", "ghp_", "github_pat_", "glpat-", "AKIA", "xoxb-", "xoxp-", "AIza", "-----BEGIN"]
  },
  "vscode": { "bin": "code", "tmos_secs": 120 },
  "sync": {
    "tie_secs": 120,
    "trash_dir": "zzzz-delete-force-items",
    "big_files": 50,
    "base_dir": "{home}/.04-clou-secr/deve-base",
    "merge_globs": ["*.zig", "*.zon", "*.js", "*.mjs", "*.ts", "*.py", "*.sh", "*.ps1", "*.c", "*.h", "*.cpp", "*.hpp", "*.css", "*.html", "*.json", "*.yml", "*.yaml", "*.md", "*.txt"],
    "git_bin": "git"
  },
  "items": [
    { "id": "claude-md", "kind": "file", "root": "claude", "from": "claude/CLAUDE.md", "to": "CLAUDE.md" },
    {
      "id": "claude-settings", "kind": "merge", "root": "claude", "from": "claude/settings.shared.json", "to": "settings.json",
      "keys": ["fallbackModel", "alwaysThinkingEnabled", "effortLevel", "modelSettings", "tui", "editorMode", "verbose", "switchModelsOnFlag", "remoteControlAtStartup", "agentPushNotifEnabled"]
    },
    { "id": "claude-keybindings", "kind": "file", "root": "claude", "from": "claude/keybindings.json", "to": "keybindings.json" },
    { "id": "claude-agents", "kind": "dir", "root": "claude", "from": "claude/agents", "to": "agents", "skip": [".99-save/*", "*.7z"] },
    { "id": "claude-skills", "kind": "dir", "root": "claude", "from": "claude/skills", "to": "skills", "skip": ["synced/*"] },
    { "id": "claude-rules", "kind": "dir", "root": "claude", "from": "claude/rules", "to": "rules", "skip": [] },
    { "id": "claude-commands", "kind": "dir", "root": "claude", "from": "claude/commands", "to": "commands", "skip": [] },
    { "id": "claude-memory-path", "kind": "merge", "root": "repo", "to": ".claude/settings.local.json", "set": [{ "key": "autoMemoryDirectory", "value": "{repo}/.claude/memory" }] },
    { "id": "vscode-settings", "kind": "file", "root": "vscode", "from": "vscode/settings.json", "to": "settings.json" },
    { "id": "vscode-keybindings", "kind": "file", "root": "vscode", "from": "vscode/keybindings.json", "to": "keybindings.json" },
    { "id": "vscode-snippets", "kind": "dir", "root": "vscode", "from": "vscode/snippets", "to": "snippets", "skip": [] },
    { "id": "vscode-extensions", "kind": "exts", "root": "vscode", "from": "vscode/extensions.txt" }
  ]
}

    "token_url": "https://api.x.com/2/oauth2/token",
    "scopes": ["tweet.read", "tweet.write", "users.read", "media.write", "offline.access"],
    "redirect_uri": "",
    "port": 8765,
    "login_wait_s": 300
  },
  "api": { "base": "https://api.x.com", "web_base": "https://x.com", "fields_param": "post.fields" },
  "approval": { "require_for_review": true },
  "retry_pre_send": 2,
  "token_refresh_s": 600,
  "token_warn_days": 30
